rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contracts/{contractId} {
      allow create: if request.auth != null;
      allow get: if true;
      allow list: if request.auth != null && resource.data.creatorId == request.auth.uid;
      
      // Production Rule: Only creator can update
      allow update, delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /verification_codes/{docId} {
      // Allow creation of OTP documents
      allow create: if true;
      allow get: if true;
      allow list, delete, update: if false;
    }

    match /auth_tokens/{docId} {
      // Allow creation for server-side generation
      allow create: if true;
      // Allow specific token lookup
      allow get: if true;
      // Protect from listing or batch updates
      allow list, delete, update: if false;
    }
  }
}
