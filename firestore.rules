rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contracts/{contractId} {
      // 1. Creation: Only authenticated users can create contracts
      allow create: if request.auth != null;

      // 2. Reading (Single): Anyone can view a single contract (needed for public signing page)
      allow get: if true;

      // 3. Reading (List): Only the creator can list their own contracts
      // The query in the app must match this: .where('creatorId', '==', auth.uid)
      allow list: if request.auth != null && resource.data.creatorId == request.auth.uid;

      // 4. Updates: 
      // - Creator can update (if needed)
      // - Public can update (for signing). In a real app, strict validation would be here.
      allow update: if true;
    }
  }
}
